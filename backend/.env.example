PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/sweetbot
# Comma-separated browser origins allowed to call the API (admin app, and your website when it uses /api/public/*)
CLIENT_ORIGIN=http://localhost:5173
# Public HTTPS URL of THIS backend (ngrok / domain). Used to show webhook URLs on the Setup page.
PUBLIC_URL=

# Admin dashboard login (created by `npm run seed`)
ADMIN_USER=admin
ADMIN_PASSWORD=ChangeMe@123
JWT_SECRET=put_a_long_random_string_here
# Optional: separate key for encrypting saved secrets (defaults to JWT_SECRET). Don't change after saving secrets.
ENCRYPTION_KEY=

# ------------------------------------------------------------------
# WhatsApp / Meta / Razorpay credentials are normally entered in the
# admin app  ->  Setup page (saved encrypted in MongoDB).
# The values below are OPTIONAL fallbacks.
# ------------------------------------------------------------------
APP_ID=
GRAPH_VERSION=v25.0
VERIFY_TOKEN=
WA_TOKEN=
PHONE_NUMBER_ID=
APP_SECRET=
CATALOG_ID=
RZP_KEY_ID=
RZP_KEY_SECRET=
RZP_WEBHOOK_SECRET=
OWNER_PHONE=
SHOP_NAME=Krishna Jelabi Kadai
